---
/* Footer: wordmark playground, contacts, resources and Moscow time — by vasnev.art */
---
<footer class="ft wrap" id="ft">
  <div class="ft-play" id="ftPlay">
    <canvas class="ft-word" id="ftWord" role="img" aria-label="vasnev.art"></canvas>
    <div class="ft-toys" id="ftToys" aria-hidden="true">
    <div class="fts" data-k="circ"><svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#FFD43B"/></svg></div>
    <div class="fts" data-k="sq"><svg viewBox="0 0 100 100"><rect x="4" y="4" width="92" height="92" rx="24" fill="#2F5CFF"/></svg></div>
    <div class="fts" data-k="tri"><svg viewBox="0 0 100 100"><path d="M50 10 94 86H6Z" fill="#FF8AD8" stroke="#FF8AD8" stroke-width="10" stroke-linejoin="round"/></svg></div>
    <div class="fts" data-k="cur"><svg viewBox="0 0 100 100"><path d="M24 6v80l20-19 14 31 17-8-14-30 28-2Z" fill="#0B0B0C" stroke="#fff" stroke-width="4" stroke-linejoin="round"/></svg></div>
    <div class="fts" data-k="comp"><svg viewBox="-.6 -.6 8.2 8.2"><path d="M3.5 0 5 1.5 3.5 3 2 1.5ZM1.5 2 3 3.5 1.5 5 0 3.5ZM5.5 2 7 3.5 5.5 5 4 3.5ZM3.5 4 5 5.5 3.5 7 2 5.5Z" fill="#8E5CFF" stroke="#8E5CFF" stroke-width=".5" stroke-linejoin="round"/></svg></div>
    <div class="fts" data-k="frame"><svg viewBox="0 0 100 100"><rect x="10" y="10" width="80" height="80" rx="3" fill="#D9CBFF"/><rect x="10" y="10" width="80" height="80" rx="3" fill="none" stroke="#6CA7FF" stroke-width="3"/><rect x="3" y="3" width="14" height="14" fill="#fff" stroke="#6CA7FF" stroke-width="3"/><rect x="83" y="3" width="14" height="14" fill="#fff" stroke="#6CA7FF" stroke-width="3"/><rect x="3" y="83" width="14" height="14" fill="#fff" stroke="#6CA7FF" stroke-width="3"/><rect x="83" y="83" width="14" height="14" fill="#fff" stroke="#6CA7FF" stroke-width="3"/></svg></div>
    <div class="fts" data-k="pen"><svg viewBox="0 0 100 100"><path d="M8 78C30 20 70 20 92 78" fill="none" stroke="#FF7A45" stroke-width="9" stroke-linecap="round"/><path d="M20 30H80" stroke="#0B0B0C" stroke-width="3"/><circle cx="20" cy="30" r="7" fill="#fff" stroke="#0B0B0C" stroke-width="3"/><circle cx="80" cy="30" r="7" fill="#fff" stroke="#0B0B0C" stroke-width="3"/><rect x="40" y="20" width="20" height="20" fill="#FF7A45" stroke="#0B0B0C" stroke-width="3"/></svg></div>
    </div>
  </div>
  <div class="xp-wrap">
    <section class="xp" aria-label="Контакты и ресурсы">
      <h3 class="xp-g">Контакты</h3>
      <ul class="xl">
        <li class="xr"><span class="xt" style="--b:#26A5E4;--f:#fff"><svg class="lg" viewBox="4.6 6.1 13.4 12.6" aria-hidden="true"><path d="M16.906 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg></span><b class="xn">Telegram</b><a class="xb" href="https://t.me/RomanVasnev" target="_blank" rel="noopener" data-tip="Telegram" data-tip-sub="@RomanVasnev">Написать<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5"/></svg></a></li>
        <li class="xr"><span class="xt xt-max" style="--b:#3B5BFF;--f:#fff"><svg class="lg" viewBox="0 0 100 100" aria-hidden="true"><path fill-rule="evenodd" d="M50.7571 0.261719C78.2929 0.261719 99.8857 22.5974 99.8857 50.1474C99.8857 77.6974 77.6071 99.4903 51.0214 99.4903C41.5857 99.4903 37.0143 98.1617 29.65 92.9474C29.1429 92.5903 28.45 92.6831 28.0214 93.1403C22.3571 99.1831 7.85 103.426 7.18571 95.176C7.18571 80.7903 0 71.4474 0 49.876C0 21.5546 23.2214 0.261719 50.7571 0.261719ZM51.5286 24.8117C38.4643 24.126 28.2643 33.1974 26.0143 47.3831C24.15 59.1332 27.45 73.4546 30.2786 74.176C31.4786 74.4832 34.3571 72.276 36.4571 70.2974C36.85 69.926 37.45 69.8617 37.9071 70.1474C41.1786 72.1474 44.8786 73.6474 48.9571 73.8617C62.3714 74.5617 74.2571 64.0617 74.9643 50.6474C75.6643 37.2331 64.9429 25.5046 51.5286 24.8046V24.8117Z"/></svg></span><b class="xn">MAX</b><a class="xb" href="https://max.ru/u/f9LHodD0cOK4eRodbkhxQK8rvB1LvE0quIyuQ6KT-D9FbLrRK_ah-9t5UUU" target="_blank" rel="noopener" data-tip="MAX" data-tip-sub="мессенджер MAX">Написать<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5"/></svg></a></li>
        <li class="xr"><span class="xt" style="--b:#0B0B0C;--f:#fff"><svg class="lg lg-s" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="3"/><path d="m4 7.5 8 5.5 8-5.5"/></svg></span><b class="xn">E-mail</b><a class="xb" href="mailto:roman.vasnev@mail.ru" data-copy="roman.vasnev@mail.ru" data-tip="E-mail" data-tip-sub="roman.vasnev@mail.ru">Скопировать</a></li>
      </ul>
      <h3 class="xp-g">Ресурсы</h3>
      <ul class="xl">
        <li class="xr"><span class="xt xt-img"><img src="data:image/webp;base64," alt=""></span><b class="xn">21st.dev</b><a class="xb" href="https://21st.dev/romanvasnev" target="_blank" rel="noopener" data-tip="21st.dev" data-tip-sub="UI-компоненты">Открыть<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5"/></svg></a></li>
        <li class="xr"><span class="xt xt-img"><img src="data:image/webp;base64," alt=""></span><b class="xn">Craftwork</b><a class="xb" href="#" target="_blank" rel="noopener" data-pending data-tip="Craftwork" data-tip-sub="шаблоны и киты">Открыть<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5"/></svg></a></li>
        </ul>
    </section>
    <section class="tw" aria-label="Время в Москве">
      <header class="tw-h"><span class="tw-city"><svg viewBox="0 0 12 16" aria-hidden="true"><path d="M6 15s5-5.1 5-8.6A5 5 0 0 0 1 6.4C1 9.9 6 15 6 15Z"/><circle cx="6" cy="6.3" r="1.9"/></svg>Москва</span><span class="tw-tz">UTC+3</span></header>
      <div class="tw-globe" aria-hidden="true"><canvas id="twG"></canvas><div class="tw-pin" id="twPin"><span>Москва</span></div></div>
      <div class="tw-t" aria-live="off"><span id="twHM">--:--</span><span class="tw-s" id="twS">:--</span></div>
      <div class="tw-d"><span id="twD"></span></div>
      <div class="tw-bar" aria-hidden="true"><i id="twBar"></i><span style="left:37.5%"></span><span style="left:79.2%"></span></div>
      <div class="tw-l" aria-hidden="true"><span>09:00</span><span>19:00</span></div>
    </section>
  </div>
</footer>
